# ─── REQUIRED ────────────────────────────────────────────────────────────────

# Anthropic API key — https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Tavily search API key — https://tavily.com/ (free tier OK for dev)
TAVILY_API_KEY=

# ─── COST GATE (required for any deployed instance) ──────────────────────────

# Comma-separated list of accepted invite codes — SEEDED INTO THE DB ON FIRST
# RUN. After that, the DB is the source of truth (codes can also be added by
# auto-mint or `npm run admin-codes mint`). Removing a code from this list
# does NOT revoke it; use `npm run admin-codes revoke <code>` to revoke.
#
# Empty INVITE_CODES + AUTO_MINT_ENABLED=false = gate is OFF (every request
# passes). Local dev typically leaves both unset; PRODUCTION MUST SET AT LEAST
# ONE to prevent unbounded LLM costs from anonymous traffic.
#
# Example: INVITE_CODES=alpha-7f2e,alpha-9d4b,family
INVITE_CODES=

# Max dossiers per code, LIFETIME (across all days for that code, ever).
# Default 10. At ~$0.20–0.30 per cold dossier, 10 lifetime is ~$3 worst case
# per code, total. Once a code hits the cap, it's exhausted permanently —
# bump this value or hand the user a fresh invite code if they need more.
INVITE_DOSSIER_LIMIT=10

# ─── SELF-SERVICE INVITE MINT ────────────────────────────────────────────────
# When AUTO_MINT_ENABLED=true, the /api/request-invite endpoint is live: a
# user submits a claim they'd like to verify, the server runs the existing
# claim normalizer on it, and on accept mints a fresh invite code and
# returns it. The friction (writing a verifiable claim) IS the gate — no
# new "judge the user's stated intent" prompt, no PII collected.
#
# Off by default. Enabling this also turns the cost gate ON regardless of
# whether INVITE_CODES is set.
AUTO_MINT_ENABLED=false

# Site-wide max codes auto-minted per UTC day. Hard circuit breaker. At the
# default of 20/day, worst-case daily exposure is ~20 × 10 dossiers ×
# ~$0.25 = ~$50 if everyone burns their full quota same-day. Bump this if
# you've grown past it; lower it if you want a tighter ceiling.
AUTO_MINT_DAILY_CAP=20

# Max successful mints per IP per rolling hour. Refinement attempts (claim
# rejected as too vague / not a claim) are FREE — only successful mints
# count toward this. Stops scripted abuse of the mint endpoint without
# punishing users who iterate on a vague claim.
AUTO_MINT_RATE_LIMIT_PER_IP=3

# ─── NETWORK ─────────────────────────────────────────────────────────────────

# Listen port. Railway / Fly / Heroku-style platforms set this automatically.
PORT=8787

# Bind address. Defaults to 127.0.0.1 in dev, 0.0.0.0 in production
# (NODE_ENV=production triggers the switch). Override here if you want
# something specific.
# HOST=0.0.0.0

# Allowed CORS origins. Comma-separated; the browser preflight needs at least
# one to match. Production: list every host the web app might be served from.
# Example: WEB_ORIGIN=https://proofiness.org,https://www.proofiness.org
WEB_ORIGIN=http://localhost:5173

# ─── STORAGE ─────────────────────────────────────────────────────────────────

# SQLite database path. Default: ./data/proofiness.db (relative to the API
# working directory). On a hosted platform with a mounted volume, point this
# at the volume — e.g. PROOFINESS_DB_PATH=/data/proofiness.db on Railway.
# PROOFINESS_DB_PATH=./data/proofiness.db

# ─── MODEL SELECTION (optional — defaults are per spec) ──────────────────────

# Sonnet 4.6 for decomposition (per spec §5: "Use Claude Sonnet 4.6 or current
# equivalent for decomposition, synthesis, and steelman generation").
DECOMPOSE_MODEL=claude-sonnet-4-6

# Optional per-step overrides — uncomment + set if you want to tune.
# NORMALIZE_MODEL=claude-haiku-4-5
# CLASSIFY_MODEL=claude-haiku-4-5
# STEELMAN_MODEL=claude-sonnet-4-6
# CONTESTATION_MODEL=claude-sonnet-4-6
# CRUX_MODEL=claude-sonnet-4-6
# ASSESS_MODEL=claude-sonnet-4-6
# EXTRACT_CITATIONS_MODEL=claude-haiku-4-5
