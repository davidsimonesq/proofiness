# Required — get from https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Required — get from https://tavily.com/ (free tier OK for dev)
TAVILY_API_KEY=

# Optional
PORT=8787
WEB_ORIGIN=http://localhost:5173

# Model selection — defaults are per the build spec.
# Sonnet 4.6 for decomposition (per spec §5: "Use Claude Sonnet 4.6 or current equivalent
# for decomposition, synthesis, and steelman generation").
DECOMPOSE_MODEL=claude-sonnet-4-6
