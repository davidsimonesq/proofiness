# ─── REQUIRED ────────────────────────────────────────────────────────────────

# Anthropic API key — https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Tavily search API key — https://tavily.com/ (free tier OK for dev)
TAVILY_API_KEY=

# ─── COST GATE (required for any deployed instance) ──────────────────────────

# Comma-separated list of accepted invite codes. Empty = gate is OFF (every
# request passes). Local dev typically leaves this unset; PRODUCTION MUST SET IT
# to prevent unbounded LLM costs from anonymous traffic.
#
# Example: INVITE_CODES=alpha-7f2e,alpha-9d4b,family
INVITE_CODES=

# Max dossiers per code per day. Default 10. At ~$0.10–0.30 per cold dossier,
# 10/day is ~$3/day worst case per code.
DAILY_DOSSIER_LIMIT=10

# ─── NETWORK ─────────────────────────────────────────────────────────────────

# Listen port. Railway / Fly / Heroku-style platforms set this automatically.
PORT=8787

# Bind address. Defaults to 127.0.0.1 in dev, 0.0.0.0 in production
# (NODE_ENV=production triggers the switch). Override here if you want
# something specific.
# HOST=0.0.0.0

# Allowed CORS origins. Comma-separated; the browser preflight needs at least
# one to match. Production: list every host the web app might be served from.
# Example: WEB_ORIGIN=https://proofiness.org,https://www.proofiness.org
WEB_ORIGIN=http://localhost:5173

# ─── STORAGE ─────────────────────────────────────────────────────────────────

# SQLite database path. Default: ./data/proofiness.db (relative to the API
# working directory). On a hosted platform with a mounted volume, point this
# at the volume — e.g. PROOFINESS_DB_PATH=/data/proofiness.db on Railway.
# PROOFINESS_DB_PATH=./data/proofiness.db

# ─── MODEL SELECTION (optional — defaults are per spec) ──────────────────────

# Sonnet 4.6 for decomposition (per spec §5: "Use Claude Sonnet 4.6 or current
# equivalent for decomposition, synthesis, and steelman generation").
DECOMPOSE_MODEL=claude-sonnet-4-6

# Optional per-step overrides — uncomment + set if you want to tune.
# NORMALIZE_MODEL=claude-haiku-4-5
# CLASSIFY_MODEL=claude-haiku-4-5
# STEELMAN_MODEL=claude-sonnet-4-6
# CONTESTATION_MODEL=claude-sonnet-4-6
# CRUX_MODEL=claude-sonnet-4-6
# ASSESS_MODEL=claude-sonnet-4-6
# EXTRACT_CITATIONS_MODEL=claude-haiku-4-5
