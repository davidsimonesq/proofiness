# Web — Vite build-time environment.
# Variables prefixed with VITE_ are inlined into the static bundle at build
# time. They're public; do not put secrets here.

# Absolute base URL for the API. Leave EMPTY for same-origin deployments
# (the dev server's vite proxy handles this in dev). In production with the
# web on SiteGround and the API on Railway, set to the API host:
#   VITE_API_BASE_URL=https://api.proofiness.org
#
# Trailing slash is stripped automatically; either form works.
VITE_API_BASE_URL=

# Public-facing base URL the share-link feature uses. Leave EMPTY to fall
# back to window.location.origin (which is the local dev server in dev). For
# production, set to the public web origin so shared links point at it
# rather than wherever the user was browsing:
#   VITE_PUBLIC_BASE_URL=https://proofiness.org
VITE_PUBLIC_BASE_URL=
