# SPA fallback — if the URL path doesn't match a real file or folder,
# serve index.html so client-side routing can take over.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# Cache the hashed asset bundles for a year. Vite emits files like
# "index-a3f9c2e1.js" — the hash changes whenever the content changes,
# so a year-long cache is safe and makes repeat visits instant.
# Never cache index.html — it references the hashed asset filenames,
# so browsers need to refetch on every visit to pick up new asset URLs
# after each deploy.
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|svg|png|jpg|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>
