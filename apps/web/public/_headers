# Cloudflare Pages cache-control directives.

# Vite-bundled hashed assets — filenames change on every build (e.g.
# index-a3f9c2e1.js), so it's safe to cache forever as immutable.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Top-level brand assets keep stable filenames but their content updates
# between deploys (logo, OG image, favicon). Cache for an hour so updates
# propagate quickly without hammering the origin.
/og-image.png
  Cache-Control: public, max-age=3600

/og-image.svg
  Cache-Control: public, max-age=3600

/proofiness-logo.png
  Cache-Control: public, max-age=3600

/icon.svg
  Cache-Control: public, max-age=3600

# Web manifest can change between deploys (theme color, app name, icons).
/manifest.json
  Cache-Control: public, max-age=3600

# Robots.txt — short cache so changes propagate.
/robots.txt
  Cache-Control: public, max-age=3600

# Entry document — never cache. New deploys must appear immediately so the
# new asset filenames it references are picked up.
/index.html
  Cache-Control: no-cache, must-revalidate

/
  Cache-Control: no-cache, must-revalidate
